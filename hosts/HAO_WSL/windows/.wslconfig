[wsl2]
# vmIdleTimeout is in MILLISECONDS: 0 means "shut down as soon as idle", which
# used to kill the distro (and every service in it). This value is only a
# fallback -- the real fix is the keep-alive script, see windows\README.md.
vmIdleTimeout=86400000
networkingMode=mirrored
memory=10GB
processors=4
# 2026-10-07: was 2GB and got filled up during a nixos-rebuild (cold pages
# stayed in swap while 7.8GB RAM was free). With 10GB RAM a small 512M swap
# is only a safety valve; raise it again only if memory pressure returns.
swap=512M

[experimental]
autoMemoryReclaim=gradual
hostAddressLoopback=true
